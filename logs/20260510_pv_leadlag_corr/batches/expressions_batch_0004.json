    "truncation": 0.08,
    "neutralization": "NONE",
    "pasteurization": "OFF",
    "maxTrade": "OFF",
    "maxPosition": "OFF",
    "unitHandling": "VERIFY",
    "nanHandling": "OFF",
    "visualization": false,
    "testPeriod": "P0Y0M"
  },
  "expressions": [
    "ts_min(subtract(divide(close, ts_delay(close, 2)), 1), 240)",
    "reverse(ts_max(subtract(divide(close, ts_delay(close, 4)), 1), 240))",
    "reverse(ts_max(subtract(divide(close, ts_delay(close, 1)), 1), 240))",
    "reverse(ts_max(subtract(divide(high, ts_delay(low, 1)), 1), 240))",
    "ts_min(subtract(divide(close, ts_delay(close, 5)), 1), 240)",
    "reverse(subtract(divide(ts_max(high, 20), ts_min(low, 20)), 1))",
    "reverse(subtract(divide(ts_max(close, 240), ts_min(close, 240)), 1))",
    "ts_arg_min(close, 240)"
  ]
