{
  "mechanism": "peak_drawup_drawdown",
  "rationale": "QML ICIR=-3.85 on Max(close/Ref(close,4)-1, 240) and +4.16 on Min(close/Ref(close,2)-1, 240). Captures the asymmetry of extreme single-day moves at annual scale. Reverse signed to give a one-sided long edge.",
  "settings": {
    "instrumentType": "EQUITY",
